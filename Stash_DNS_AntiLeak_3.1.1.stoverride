name: DNS 防泄漏（Stash 3.1.1）
desc: 参考 Shadowrocket DNS 防泄漏参数，仅覆写 DNS/IPv6；不修改代理分组、节点选择和现有分流规则。
category: General

# Shadowrocket: ipv6 = false / prefer-ipv6 = false
# 关闭 IPv6，减少因 IPv6 路径与 IPv4 代理路径不同造成的 DNS/出口暴露风险。
ipv6: false

# 仅替换 DNS 段，不触碰 proxy-groups / rule-providers / rules。
dns: #!replace
  enable: true
  ipv6: false

  # 使用 Fake-IP，尽量避免需要代理的域名先在本地进行真实 DNS 查询。
  enhanced-mode: fake-ip

  # 对应 Shadowrocket 的 #proxy：让 Stash 发出的 DNS 查询按照现有分流规则转发。
  follow-rule: true

  # Stash 3.1.1 使用传统 IP Bootstrap，避免使用 3.6+ 才完整支持的新 DNS Bootstrap 写法。
  # 不使用 system，避免回落到当前 Wi-Fi / ISP DNS。
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29

  # 对应 Shadowrocket：
  # dns-server = https://cloudflare-dns.com/dns-query#proxy
  # fallback-dns-server = https://dns.google/dns-query#proxy
  # 这里改用 IP 形式 DoH，避免解析 DoH 主机名时产生额外 Bootstrap/递归问题。
  nameserver:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

  # 仅排除本地发现、反向解析、STUN 和部分 Apple 系统域名的 Fake-IP。
  # 这些请求仍由上面的 DNS 逻辑处理，不加入 system DNS。
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.home.arpa'
    - '*.in-addr.arpa'
    - '*.ip6.arpa'
    - '*._dns-sd._udp.*.in-addr.arpa'
    - 'localhost'
    - 'localhost.weixin.qq.com'
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'
    - 'captive.apple.com'
    - '*.icloud.com'
    - '*.icloud-content.com'
    - '*.apple-cloudkit.com'
    - '*.cdn-apple.com'
    - '*.mzstatic.com'
