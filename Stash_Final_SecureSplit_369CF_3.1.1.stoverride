name: Stash Final Secure Split (369-CF)
desc: 基于当前 369-CF优选 主配置定制。保留原订阅节点；国内明确白名单直连，其余流量统一走安全代理组。DNS 使用 Cloudflare/Google DoH，关闭 IPv6；自动测速 120 秒。用于替代 Universal Rules / Rules 策略分流 / CustomDNS / 旧 DNS 覆写 / v6-v7。
category: Policy

ipv6: false

dns: #!replace
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  follow-rule: true

  # 只使用公共海外解析器，不再混入运营商/阿里/腾讯系统 DNS
  default-nameserver:
    - 1.1.1.1
    - 8.8.8.8

  nameserver:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.home.arpa'
    - '*.in-addr.arpa'
    - '*.ip6.arpa'
    - '*._dns-sd._udp.*.in-addr.arpa'
    - 'localhost'
    - 'localhost.weixin.qq.com'
    - 'captive.apple.com'
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'

# 不替换原有 proxy-groups，只新增两个唯一命名的安全组。
# 安全组内完全没有 DIRECT，避免任何国外流量因策略组选择而退化为直连。
proxy-groups:
  - name: 🔒 369安全自动
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 120
    tolerance: 50
    lazy: false
    proxies:
      - CF 电信优选
      - CF 电信优选 2
      - CF 电信优选 3
      - CF 电信优选 4
      - CF 电信优选 5
      - CF 电信优选 6
      - CF 联通优选
      - CF 联通优选 2
      - CF 联通优选 3
      - CF 联通优选 4
      - CF 移动优选
      - CF 移动优选 2
      - CF 移动优选 3
      - CF 移动优选 4
      - CF 移动优选 5
      - CF 移动优选 6
      - CF 移动优选 7
      - CF 移动优选 8

  - name: 🔒 369安全出口
    type: select
    proxies:
      - 🔒 369安全自动
      - CF 电信优选
      - CF 电信优选 2
      - CF 电信优选 3
      - CF 电信优选 4
      - CF 电信优选 5
      - CF 电信优选 6
      - CF 联通优选
      - CF 联通优选 2
      - CF 联通优选 3
      - CF 联通优选 4
      - CF 移动优选
      - CF 移动优选 2
      - CF 移动优选 3
      - CF 移动优选 4
      - CF 移动优选 5
      - CF 移动优选 6
      - CF 移动优选 7
      - CF 移动优选 8

rule-providers:
