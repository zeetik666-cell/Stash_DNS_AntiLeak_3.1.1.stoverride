  # ---- 国内服务规则集补全 ----
  - RULE-SET,Final-Alibaba,DIRECT
  - RULE-SET,Final-XianYu,DIRECT
  - RULE-SET,Final-MeiTuan,DIRECT
  - RULE-SET,Final-Eleme,DIRECT
  - RULE-SET,Final-BiliBili,DIRECT
  - RULE-SET,Final-XiaoHongShu,DIRECT
  - RULE-SET,Final-Weibo,DIRECT
  - RULE-SET,Final-Tencent,DIRECT
  - RULE-SET,Final-WeChat,DIRECT
  - RULE-SET,Final-Baidu,DIRECT
  - RULE-SET,Final-DouYin,DIRECT
  - RULE-SET,Final-JingDong,DIRECT
  - RULE-SET,Final-NetEase,DIRECT
