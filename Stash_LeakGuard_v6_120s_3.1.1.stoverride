name: Stash LeakGuard v6 (Primary IP First)
desc: 先修复主出口 IP 泄露。仅明确国内服务 DIRECT；其余所有流量直接交给美国自动组。无 DIRECT 备用项、无 QUIC 特判、无 ChinaMax/GEOIP CN。DNS 恢复为此前已验证的纯防泄漏方案。兼容 Stash 3.1.1。
category: General

# 关闭 IPv6，避免 IPv4/IPv6 出口不一致
ipv6: false

# ============================================================
# 1) DNS：恢复此前已验证成功的纯防泄漏方案
# ============================================================
dns: #!replace
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  follow-rule: true

  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29

  nameserver:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.home.arpa'
    - '*.in-addr.arpa'
    - '*.ip6.arpa'
    - '*._dns-sd._udp.*.in-addr.arpa'
    - 'localhost'
    - 'localhost.weixin.qq.com'
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'
    - 'captive.apple.com'
    - '*.icloud.com'
    - '*.icloud-content.com'
    - '*.apple-cloudkit.com'
    - '*.cdn-apple.com'
    - '*.mzstatic.com'

# ============================================================
# 2) 唯一国外出口：美国节点自动测速
#    关键：过滤条件只匹配你实际存在的美国节点命名，
#    DIRECT / REJECT 不会被纳入测速候选。
# ============================================================
proxy-groups:
  - name: 🇺🇸 STASH-出口保护
    type: url-test
    include-all: true
    filter: '(?i)(🇺🇸|美国|美國|UNITED STATES|United States|USA|America|Boston|Los Angeles|San Jose|Seattle|New York|Chicago|Dallas|Phoenix|波士顿|波士頓|洛杉矶|洛杉磯|圣何塞|聖何塞|西雅图|西雅圖|纽约|紐約|芝加哥|达拉斯|達拉斯|凤凰城|鳳凰城|沪美)'
    interval: 120
    tolerance: 50

# ============================================================
# 3) 仅保留明确国内白名单规则集
# ============================================================
rule-providers:
  Stash-Alibaba:
    behavior: domain
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Alibaba/Alibaba_Domain.yaml

  Stash-XianYu:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/XianYu/XianYu.yaml

  Stash-MeiTuan:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/MeiTuan/MeiTuan.yaml

  Stash-Eleme:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Eleme/Eleme.yaml

  Stash-BiliBili:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/BiliBili/BiliBili.yaml

  Stash-XiaoHongShu:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/XiaoHongShu/XiaoHongShu.yaml

  Stash-Weibo:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Weibo/Weibo.yaml

  Stash-Tencent:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Tencent/Tencent.yaml

  Stash-WeChat:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/WeChat/WeChat.yaml

  Stash-Baidu:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Baidu/Baidu.yaml

  Stash-DouYin:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/DouYin/DouYin.yaml

  Stash-JingDong:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/JingDong/JingDong.yaml

  Stash-NetEase:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/NetEase/NetEase.yaml

  Stash-GaoDe:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/GaoDe/GaoDe.yaml

  Stash-DiDi:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/DiDi/DiDi.yaml

  Stash-BlockHttpDNS:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/BlockHttpDNS/BlockHttpDNS.yaml

# ============================================================
# 4) 分流：白名单 DIRECT，其余一律美国代理
# ============================================================
rules: #!replace
  # 本机/局域网
  - DOMAIN,localhost.weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - DOMAIN-SUFFIX,home.arpa,DIRECT
  - DOMAIN-SUFFIX,in-addr.arpa,DIRECT
  - DOMAIN-SUFFIX,ip6.arpa,DIRECT
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve

  # 明确国内服务白名单
  - RULE-SET,Stash-Alibaba,DIRECT
  - RULE-SET,Stash-XianYu,DIRECT
  - RULE-SET,Stash-MeiTuan,DIRECT
  - RULE-SET,Stash-Eleme,DIRECT
  - RULE-SET,Stash-BiliBili,DIRECT
  - RULE-SET,Stash-XiaoHongShu,DIRECT
  - RULE-SET,Stash-Weibo,DIRECT
  - RULE-SET,Stash-Tencent,DIRECT
  - RULE-SET,Stash-WeChat,DIRECT
  - RULE-SET,Stash-Baidu,DIRECT
  - RULE-SET,Stash-DouYin,DIRECT
  - RULE-SET,Stash-JingDong,DIRECT
  - RULE-SET,Stash-NetEase,DIRECT
  - RULE-SET,Stash-GaoDe,DIRECT
  - RULE-SET,Stash-DiDi,DIRECT
  - DOMAIN-SUFFIX,doubao.com,DIRECT
  - DOMAIN-SUFFIX,byteimg.com,DIRECT
  - DOMAIN-SUFFIX,bytedance.com,DIRECT

  # 其余已知 HTTPDNS / 应用自带 DNS 拦截
  - RULE-SET,Stash-BlockHttpDNS,REJECT

  # 关键：没有任何 DIRECT 兜底，所有其余流量直接走美国自动组
  - MATCH,🇺🇸 STASH-出口保护
