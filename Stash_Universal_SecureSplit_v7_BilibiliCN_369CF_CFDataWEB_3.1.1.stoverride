name: Stash Universal Secure Split v7 (Bilibili CN + CN Fast)
desc: v7 Bilibili 中国大陆优化版：Bilibili 主站/API/视频/CDN 强制 DIRECT + 国内 DNS；Bilibili Intl/Bstar 国际端点不再误归入国内直连。保留 v6 的国内 App、Apple Music、国外安全出口与双主配置兼容逻辑。兼容 Stash 3.1.1。
category: Policy

ipv6: false

dns: #!replace
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  follow-rule: true

  # Bootstrap 只负责解析 DoH 服务器域名；国内 UDP 可降低启动/重连解析延迟。
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29

  nameserver:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query


  # 国内 App 定向 DNS：只让明确的中国大陆生态使用国内 DoH，
  # BrowserLeaks / 国外网站仍使用上面的 Cloudflare / Google DoH。
  nameserver-policy:
    '+.cn': '223.5.5.5'

    # 阿里 / 淘宝 / 闲鱼 / 支付宝
    '+.taobao.com': '223.5.5.5'
    '+.tmall.com': '223.5.5.5'
    '+.alicdn.com': '223.5.5.5'
    '+.taobaocdn.com': '223.5.5.5'
    '+.tbcdn.cn': '223.5.5.5'
    '+.goofish.com': '223.5.5.5'
    '+.xianyu.mobi': '223.5.5.5'
    '+.alipay.com': '223.5.5.5'
    '+.alipayobjects.com': '223.5.5.5'
    '+.alipaydns.com': '223.5.5.5'

    # 拼多多
    '+.pinduoduo.com': '223.5.5.5'
    '+.pinduoduo.net': '223.5.5.5'
    '+.pddpic.com': '223.5.5.5'
    '+.yangkeduo.com': '223.5.5.5'

    # 抖音 / 字节
    '+.douyin.com': '223.5.5.5'
    '+.douyincdn.com': '223.5.5.5'
    '+.douyinpic.com': '223.5.5.5'
    '+.douyinstatic.com': '223.5.5.5'
    '+.douyinvod.com': '223.5.5.5'
    '+.amemv.com': '223.5.5.5'
    '+.snssdk.com': '223.5.5.5'
    '+.byteimg.com': '223.5.5.5'
    '+.bytedance.com': '223.5.5.5'

    # 携程 / 去哪儿
    '+.ctrip.com': '223.5.5.5'
    '+.ctrip.cn': '223.5.5.5'
    '+.c-ctrip.com': '223.5.5.5'
    '+.tripcdn.com': '223.5.5.5'
    '+.qunar.com': '223.5.5.5'
    '+.qunarzz.com': '223.5.5.5'

    # 滴滴
    '+.didi.cn': '223.5.5.5'
    '+.didichuxing.com': '223.5.5.5'
    '+.didistatic.com': '223.5.5.5'
    '+.xiaojukeji.com': '223.5.5.5'
    '+.udache.com': '223.5.5.5'

    # 12306
    '+.12306.cn': '223.5.5.5'
    '+.95306.cn': '223.5.5.5'
    '+.china-railway.com.cn': '223.5.5.5'

    # 京东 / 京东支付
    '+.jd.com': '223.5.5.5'
    '+.360buyimg.com': '223.5.5.5'
    '+.jdcdn.com': '223.5.5.5'
    '+.jdpay.com': '223.5.5.5'

    # 微信 / 微信支付：优先腾讯 DoH
    '+.qq.com': '119.29.29.29'
    '+.weixin.com': '119.29.29.29'
    '+.wechat.com': '119.29.29.29'
    '+.servicewechat.com': '119.29.29.29'
    '+.tenpay.com': '119.29.29.29'
    '+.wechatpay.com': '119.29.29.29'
    '+.qpic.cn': '119.29.29.29'
    '+.qlogo.cn': '119.29.29.29'
    '+.gtimg.com': '119.29.29.29'

    # 已有国内高频 App
    '+.meituan.com': '223.5.5.5'
    '+.sankuai.com': '223.5.5.5'
    '+.dianping.com': '223.5.5.5'
    # Bilibili 中国大陆：API / 视频 / 图片 / CDN
    '+.bilibili.com': '223.5.5.5'
    '+.bilibili.cn': '223.5.5.5'
    '+.biliapi.com': '223.5.5.5'
    '+.biliapi.net': '223.5.5.5'
    '+.bilivideo.com': '223.5.5.5'
    '+.bilivideo.cn': '223.5.5.5'
    '+.bilivideo.net': '223.5.5.5'
    '+.hdslb.com': '223.5.5.5'
    '+.hdslb.net': '223.5.5.5'
    '+.hdslb.org': '223.5.5.5'
    '+.biliimg.com': '223.5.5.5'
    '+.bilicdn1.com': '223.5.5.5'
    '+.bilicdn2.com': '223.5.5.5'
    '+.bilicdn3.com': '223.5.5.5'
    '+.bilicdn4.com': '223.5.5.5'
    '+.bilicdn5.com': '223.5.5.5'
    '+.acgvideo.com': '223.5.5.5'
    '+.b23.tv': '223.5.5.5'
    '+.xiaohongshu.com': '223.5.5.5'
    '+.xhscdn.com': '223.5.5.5'
    '+.amap.com': '223.5.5.5'
    '+.autonavi.com': '223.5.5.5'

    # 小红书补齐：图片 / 视频 CDN
    '+.xhscdn.net': '223.5.5.5'
    '+.fengkongcloud.com': '223.5.5.5'

    # Apple Music 补齐：音频流 / 媒体 / CDN
    '+.music.apple.com': '223.5.5.5'
    '+.applemusic.com': '223.5.5.5'
    '+.blobstore.apple.com': '223.5.5.5'
    '+.itunes.apple.com': '223.5.5.5'

    # Apple 中国大陆常用生态
    'music.apple.com': '223.5.5.5'
    'apps.apple.com': '223.5.5.5'
    'itunes.apple.com': '223.5.5.5'
    '+.apple.com.cn': '223.5.5.5'
    '+.icloud.com.cn': '223.5.5.5'
    '+.mzstatic.com': '223.5.5.5'
    '+.cdn-apple.com': '223.5.5.5'
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.home.arpa'
    - '*.in-addr.arpa'
    - '*.ip6.arpa'
    - '*._dns-sd._udp.*.in-addr.arpa'
    - 'localhost'
    - 'localhost.weixin.qq.com'
    - 'captive.apple.com'
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'

# 不替换原有 proxy-groups，只新增两个唯一命名的安全组。
# 安全组内完全没有 DIRECT，避免任何国外流量因策略组选择而退化为直连。
proxy-groups:
  - name: 🔒 通用安全出口
    type: url-test
    include-all: true
    # 同时匹配：
    # 369-CF：CF 电信优选 / CF 联通优选 / CF 移动优选（含编号）
    # CFData-WEB：VPS789优选 / WeTest优选 / 微测优选 / 优选 | ...
    # 不匹配 DIRECT / REJECT / 原有策略组。
    filter: '^(CF (电信|联通|移动)优选( [0-9]+)?|VPS789优选|WeTest优选|微测优选|优选 \|)'
    url: http://www.gstatic.com/generate_204
    interval: 600
    tolerance: 100
    lazy: true

rule-providers:
  Final-Alibaba:
    behavior: domain
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Alibaba/Alibaba_Domain.yaml

