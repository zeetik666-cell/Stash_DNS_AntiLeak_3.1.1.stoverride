rules: #!replace
  # 国内低延迟 DNS 传输：直接出站，避免国内 App 的 DNS 绕海外代理
  - IP-CIDR,223.5.5.5/32,DIRECT,no-resolve
  - IP-CIDR,119.29.29.29/32,DIRECT,no-resolve

  # ---- DNS 传输路由：v4 修复规则模式国外 DNS 直连失败 ----
  # 国内定向 DoH 本地直连，保证国内 App 的 CDN 就近调度与低延迟
  - DOMAIN,dns.alidns.com,DIRECT
  - DOMAIN,doh.pub,DIRECT

  # 国外公共 DoH 必须经过安全代理；不能在规则模式下直接从中国网络访问
  - IP-CIDR,1.1.1.1/32,🔒 通用安全出口,no-resolve
  - IP-CIDR,8.8.8.8/32,🔒 通用安全出口,no-resolve

  # ---- v7 Bilibili：中国大陆优先 ----
  # 国际版 / Bstar 端点不作为中国大陆 Bilibili 直连路径。
  # 若 App 自己请求国际服务，则交给安全代理；不让它混入大陆 CDN。
  - DOMAIN-SUFFIX,bilibili.tv,🔒 通用安全出口
  - DOMAIN-SUFFIX,biliintl.com,🔒 通用安全出口
  - DOMAIN-SUFFIX,biliintl.co,🔒 通用安全出口
  - DOMAIN,p-bstarstatic.akamaized.net,🔒 通用安全出口
  - DOMAIN,p.bstarstatic.com,🔒 通用安全出口
  - DOMAIN,upos-bstar-mirrorakam.akamaized.net,🔒 通用安全出口
  - DOMAIN,upos-bstar1-mirrorakam.akamaized.net,🔒 通用安全出口

  # 中国大陆主站 / API / 视频 / 图片 / CDN 快速直连
  - DOMAIN-SUFFIX,bilibili.com,DIRECT
  - DOMAIN-SUFFIX,bilibili.cn,DIRECT
  - DOMAIN-SUFFIX,biliapi.com,DIRECT
  - DOMAIN-SUFFIX,biliapi.net,DIRECT
  - DOMAIN-SUFFIX,bilivideo.com,DIRECT
  - DOMAIN-SUFFIX,bilivideo.cn,DIRECT
  - DOMAIN-SUFFIX,bilivideo.net,DIRECT
  - DOMAIN-SUFFIX,hdslb.com,DIRECT
  - DOMAIN-SUFFIX,hdslb.net,DIRECT
  - DOMAIN-SUFFIX,hdslb.org,DIRECT
  - DOMAIN-SUFFIX,biliimg.com,DIRECT
  - DOMAIN-SUFFIX,bilicdn1.com,DIRECT
  - DOMAIN-SUFFIX,bilicdn2.com,DIRECT
  - DOMAIN-SUFFIX,bilicdn3.com,DIRECT
  - DOMAIN-SUFFIX,bilicdn4.com,DIRECT
  - DOMAIN-SUFFIX,bilicdn5.com,DIRECT
  - DOMAIN-SUFFIX,acgvideo.com,DIRECT
  - DOMAIN-SUFFIX,b23.tv,DIRECT
  - DOMAIN,upos-hz-mirrorakam.akamaized.net,DIRECT

  # ---- v6 高频直连快速命中：减少规则集顺序扫描 ----
  # 小红书图片 / 视频 / 风控
  - DOMAIN-SUFFIX,xiaohongshu.com,DIRECT
  - DOMAIN-SUFFIX,xhscdn.com,DIRECT
  - DOMAIN-SUFFIX,xhscdn.net,DIRECT
  - DOMAIN-SUFFIX,fengkongcloud.com,DIRECT

  # Apple Music 中国大陆常用音频 / 媒体
  - DOMAIN-SUFFIX,music.apple.com,DIRECT
  - DOMAIN-SUFFIX,applemusic.com,DIRECT
  - DOMAIN-SUFFIX,blobstore.apple.com,DIRECT
  - DOMAIN-SUFFIX,itunes.apple.com,DIRECT
  - DOMAIN,aod-ssl.itunes.apple.com,DIRECT
  - DOMAIN,audio-ssl.itunes.apple.com,DIRECT
  - DOMAIN,streamingaudio.itunes.apple.com,DIRECT
  - DOMAIN,mvod.itunes.apple.com,DIRECT

  # ---- 本机 / 局域网 ----
  - DOMAIN,localhost.weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - DOMAIN-SUFFIX,home.arpa,DIRECT
  - DOMAIN-SUFFIX,in-addr.arpa,DIRECT
  - DOMAIN-SUFFIX,ip6.arpa,DIRECT
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve

  # ---- 国内 App 的 HTTPDNS：仅这些已知入口直连，降低淘宝/美团等延迟 ----
  - IP-CIDR,203.107.1.1/32,DIRECT,no-resolve
  - IP-CIDR,119.29.29.98/32,DIRECT,no-resolve
  - IP-CIDR,119.29.29.99/32,DIRECT,no-resolve
  - DOMAIN-SUFFIX,httpdns.alicdn.com,DIRECT
  - DOMAIN-SUFFIX,httpdns.aliyun.com,DIRECT
  - DOMAIN-SUFFIX,httpdns.meituan.com,DIRECT

  # ---- 关键国内域名显式直连（即使远程规则下载失败也可用） ----
  - DOMAIN-SUFFIX,taobao.com,DIRECT
  - DOMAIN-SUFFIX,tmall.com,DIRECT
  - DOMAIN-SUFFIX,alicdn.com,DIRECT
  - DOMAIN-SUFFIX,taobaocdn.com,DIRECT
  - DOMAIN-SUFFIX,tbcdn.cn,DIRECT
  - DOMAIN-SUFFIX,alipay.com,DIRECT
  - DOMAIN-SUFFIX,alipayobjects.com,DIRECT
  - DOMAIN-SUFFIX,goofish.com,DIRECT
  - DOMAIN-SUFFIX,xianyu.mobi,DIRECT

  - DOMAIN-SUFFIX,meituan.com,DIRECT
  - DOMAIN-SUFFIX,meituan.net,DIRECT
  - DOMAIN-SUFFIX,sankuai.com,DIRECT
  - DOMAIN-SUFFIX,dianping.com,DIRECT
  - DOMAIN-SUFFIX,dpfile.com,DIRECT
  - DOMAIN-SUFFIX,ele.me,DIRECT

  - DOMAIN-SUFFIX,bilibili.com,DIRECT
  - DOMAIN-SUFFIX,biliapi.com,DIRECT
  - DOMAIN-SUFFIX,biliapi.net,DIRECT
  - DOMAIN-SUFFIX,bilivideo.com,DIRECT
  - DOMAIN-SUFFIX,hdslb.com,DIRECT
  - DOMAIN-SUFFIX,b23.tv,DIRECT

  - DOMAIN-SUFFIX,xiaohongshu.com,DIRECT
  - DOMAIN-SUFFIX,xhscdn.com,DIRECT
  - DOMAIN-SUFFIX,weibo.com,DIRECT
  - DOMAIN-SUFFIX,weibocdn.com,DIRECT

  - DOMAIN-SUFFIX,qq.com,DIRECT
  - DOMAIN-SUFFIX,qcloud.com,DIRECT
  - DOMAIN-SUFFIX,weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,wechat.com,DIRECT

  - DOMAIN-SUFFIX,jd.com,DIRECT
  - DOMAIN-SUFFIX,360buyimg.com,DIRECT
  - DOMAIN-SUFFIX,baidu.com,DIRECT
  - DOMAIN-SUFFIX,bdstatic.com,DIRECT
  - DOMAIN-SUFFIX,bcebos.com,DIRECT

