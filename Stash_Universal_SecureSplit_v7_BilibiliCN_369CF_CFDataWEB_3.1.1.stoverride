  - DOMAIN-SUFFIX,apple-dns.net,DIRECT
  - DOMAIN,push.apple.com,DIRECT
  - DOMAIN,gs.apple.com,DIRECT
  - DOMAIN,gdmf.apple.com,DIRECT
  - DOMAIN,mesu.apple.com,DIRECT

  - RULE-SET,Final-AppleMusic,DIRECT
  - RULE-SET,Final-AppStore,DIRECT
  - RULE-SET,Final-iCloud,DIRECT
  - RULE-SET,Final-AppleID,DIRECT
  - RULE-SET,Final-FindMy,DIRECT
  - RULE-SET,Final-TestFlight,DIRECT
  - RULE-SET,Final-AppleFirmware,DIRECT

  # ---- 国内高频 App v3 补齐：显式直连 ----

  # 拼多多
  - DOMAIN-SUFFIX,pinduoduo.com,DIRECT
  - DOMAIN-SUFFIX,pinduoduo.net,DIRECT
  - DOMAIN-SUFFIX,pddpic.com,DIRECT
  - DOMAIN-SUFFIX,yangkeduo.com,DIRECT

  # 抖音 / 字节视频资源
  - DOMAIN-SUFFIX,amemv.com,DIRECT
  - DOMAIN-SUFFIX,douyinpic.com,DIRECT
  - DOMAIN-SUFFIX,douyinstatic.com,DIRECT
