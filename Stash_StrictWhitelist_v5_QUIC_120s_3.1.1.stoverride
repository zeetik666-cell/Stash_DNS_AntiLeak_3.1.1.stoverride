# ============================================================
# 4) QUIC 防直连
# ============================================================
# Stash 官方建议代理场景禁用 QUIC；HTTP/3 基于 UDP。
# 这里仅拦截未先命中国内/Apple DIRECT 白名单的 UDP/443，
# 让 Safari/应用回落到 TCP/HTTP2，再按代理规则转发。
script:
  shortcuts:
    stash-quic-proxy-guard: network == 'udp' and dst_port == 443

# ============================================================
# 5) 分流规则（v5：DIRECT 严格白名单 + 非白名单 QUIC 拦截）
# ============================================================
rules: #!replace
  # ---- 本机 / 局域网基础通信 ----
  - DOMAIN,localhost.weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - DOMAIN-SUFFIX,home.arpa,DIRECT
  - DOMAIN-SUFFIX,in-addr.arpa,DIRECT
  - DOMAIN-SUFFIX,ip6.arpa,DIRECT
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve

  # ---- 国内 DoH / 已知 HTTPDNS ----
  - DOMAIN,dns.alidns.com,DIRECT
  - DOMAIN,doh.pub,DIRECT
  - IP-CIDR,203.107.1.1/32,DIRECT,no-resolve
  - IP-CIDR,119.29.29.98/32,DIRECT,no-resolve
  - IP-CIDR,119.29.29.99/32,DIRECT,no-resolve
  - DOMAIN-SUFFIX,httpdns.alicdn.com,DIRECT
  - DOMAIN-SUFFIX,httpdns.aliyun.com,DIRECT
  - DOMAIN-SUFFIX,httpdns.meituan.com,DIRECT

  # ---- Apple：当前默认 DIRECT；放在 QUIC 拦截前，保持系统服务兼容性 ----
  - DOMAIN-SUFFIX,apple.com,🍏 STASH-Apple
  - DOMAIN-SUFFIX,icloud.com,🍏 STASH-Apple
  - DOMAIN-SUFFIX,icloud-content.com,🍏 STASH-Apple
  - DOMAIN-SUFFIX,apple-cloudkit.com,🍏 STASH-Apple
  - DOMAIN-SUFFIX,cdn-apple.com,🍏 STASH-Apple
  - DOMAIN-SUFFIX,mzstatic.com,🍏 STASH-Apple

  # ---- 国内严格白名单：这些服务可直接使用中国本地网络 ----
  - RULE-SET,Stash-Alibaba,DIRECT
  - RULE-SET,Stash-XianYu,DIRECT
  - RULE-SET,Stash-MeiTuan,DIRECT
  - RULE-SET,Stash-Eleme,DIRECT
  - RULE-SET,Stash-BiliBili,DIRECT
  - RULE-SET,Stash-XiaoHongShu,DIRECT
  - RULE-SET,Stash-Weibo,DIRECT
  - RULE-SET,Stash-Tencent,DIRECT
  - RULE-SET,Stash-WeChat,DIRECT
  - RULE-SET,Stash-Baidu,DIRECT
  - RULE-SET,Stash-DouYin,DIRECT
  - RULE-SET,Stash-JingDong,DIRECT
  - RULE-SET,Stash-NetEase,DIRECT
  - RULE-SET,Stash-GaoDe,DIRECT
  - RULE-SET,Stash-DiDi,DIRECT
  - DOMAIN-SUFFIX,doubao.com,DIRECT
  - DOMAIN-SUFFIX,byteimg.com,DIRECT
  - DOMAIN-SUFFIX,bytedance.com,DIRECT

  # ---- 关键修正：其余 UDP/443（HTTP/3 / QUIC）不允许直接逃逸 ----
  # 命中后 REJECT，浏览器通常会自动回落 TCP/HTTP2，再继续按下面代理规则连接。
  - SCRIPT,stash-quic-proxy-guard,REJECT

  # ---- 明确国外服务：TCP/回落流量走代理 ----
  - RULE-SET,Stash-OpenAI,🤖 STASH-AI
  - RULE-SET,Stash-Claude,🤖 STASH-AI
  - RULE-SET,Stash-Gemini,🤖 STASH-AI
  - DOMAIN,translate.googleapis.com,📹 STASH-YouTube
  - DOMAIN,translate-pa.googleapis.com,📹 STASH-YouTube
  - RULE-SET,Stash-YouTube,📹 STASH-YouTube
  - RULE-SET,Stash-Spotify,🎵 STASH-Spotify
  - RULE-SET,Stash-TikTok,🎬 STASH-TikTok
  - RULE-SET,Stash-Telegram,📱 STASH-Telegram
  - RULE-SET,Stash-GitHub,💻 STASH-开发服务
  - RULE-SET,Stash-GitLab,💻 STASH-开发服务
  - RULE-SET,Stash-Atlassian,💻 STASH-开发服务
  - RULE-SET,Stash-Google,🔍 STASH-Google
  - RULE-SET,Stash-Microsoft,Ⓜ️ STASH-Microsoft

  # ---- 其余已知 HTTPDNS / 应用自带 DNS 拦截 ----
  - RULE-SET,Stash-BlockHttpDNS,REJECT

  # ---- 所有其他未知流量一律代理 ----
  # 不为 BrowserLeaks / IPLeak / DNSLeakTest 添加任何特殊白名单。
  - MATCH,🐟 STASH-兜底
