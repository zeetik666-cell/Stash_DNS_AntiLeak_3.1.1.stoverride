name: Stash 智能分流 + DNS 防泄漏（严格白名单 v5 / QUIC 防直连）
desc: 严格白名单模式 + QUIC 防直连：国内明确白名单 DIRECT，其余流量默认代理；对非白名单 UDP/443 直接 REJECT，强制 Safari/应用回落 TCP 后经代理，避免节点不支持 UDP 时真实出口暴露。保留国内低延迟 DNS、DNS 防泄漏与 120 秒自动测速。兼容 Stash 3.1.1。
category: General

# ============================================================
# 1) DNS：国外防泄漏 + 国内低延迟分流解析
# ============================================================
ipv6: false

dns: #!replace
  enable: true
  ipv6: false
  enhanced-mode: fake-ip

  # 保留防泄漏逻辑：国外 DNS 请求仍按分流规则经代理转发。
  # 国内域名通过 nameserver-policy 改走国内 DoH，避免绕美国节点解析
  # 导致 CDN 调度到境外、淘宝/美团等首开和图片加载变慢。
  follow-rule: true

  # 仅用于解析 DoH 服务器主机名；不使用 system DNS。
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29

  # 默认（主要给国外/代理流量）仍使用海外 DoH；在现有规则下会走代理。
  nameserver:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

  # Stash 3.1.1 兼容写法：每个 policy 使用单个字符串，不使用数组/geosite。
  # 国内高频服务使用阿里公共 DoH，就近返回中国 CDN/业务节点。
  nameserver-policy:
    # 淘宝 / 天猫 / 支付宝 / 阿里云 / 闲鱼
    '+.taobao.com': 'https://dns.alidns.com/dns-query'
    '+.tmall.com': 'https://dns.alidns.com/dns-query'
    '+.alicdn.com': 'https://dns.alidns.com/dns-query'
    '+.taobaocdn.com': 'https://dns.alidns.com/dns-query'
    '+.tbcdn.cn': 'https://dns.alidns.com/dns-query'
    '+.alipay.com': 'https://dns.alidns.com/dns-query'
    '+.alipayobjects.com': 'https://dns.alidns.com/dns-query'
    '+.aliyun.com': 'https://dns.alidns.com/dns-query'
    '+.aliyuncs.com': 'https://dns.alidns.com/dns-query'
    '+.goofish.com': 'https://dns.alidns.com/dns-query'
    '+.xianyu.mobi': 'https://dns.alidns.com/dns-query'

    # 美团 / 大众点评 / 饿了么
    '+.meituan.com': 'https://dns.alidns.com/dns-query'
    '+.meituan.net': 'https://dns.alidns.com/dns-query'
    '+.sankuai.com': 'https://dns.alidns.com/dns-query'
    '+.dianping.com': 'https://dns.alidns.com/dns-query'
    '+.dpfile.com': 'https://dns.alidns.com/dns-query'
    '+.ele.me': 'https://dns.alidns.com/dns-query'

    # 地图 / 定位资源（国内生活服务常调用）
    '+.amap.com': 'https://dns.alidns.com/dns-query'
    '+.autonavi.com': 'https://dns.alidns.com/dns-query'
    '+.gaode.com': 'https://dns.alidns.com/dns-query'

    # Bilibili / 小红书 / 微博 / 字节
    '+.bilibili.com': 'https://dns.alidns.com/dns-query'
    '+.biliapi.com': 'https://dns.alidns.com/dns-query'
    '+.biliapi.net': 'https://dns.alidns.com/dns-query'
    '+.bilivideo.com': 'https://dns.alidns.com/dns-query'
    '+.hdslb.com': 'https://dns.alidns.com/dns-query'
    '+.xiaohongshu.com': 'https://dns.alidns.com/dns-query'
    '+.xhscdn.com': 'https://dns.alidns.com/dns-query'
    '+.weibo.com': 'https://dns.alidns.com/dns-query'
    '+.weibocdn.com': 'https://dns.alidns.com/dns-query'
    '+.douyin.com': 'https://dns.alidns.com/dns-query'
    '+.douyincdn.com': 'https://dns.alidns.com/dns-query'
    '+.byteimg.com': 'https://dns.alidns.com/dns-query'
    '+.bytedance.com': 'https://dns.alidns.com/dns-query'
    '+.toutiao.com': 'https://dns.alidns.com/dns-query'

    # 微信 / QQ / 京东 / 百度 / 网易
    '+.qq.com': 'https://dns.alidns.com/dns-query'
    '+.qcloud.com': 'https://dns.alidns.com/dns-query'
    '+.weixin.qq.com': 'https://dns.alidns.com/dns-query'
    '+.jd.com': 'https://dns.alidns.com/dns-query'
    '+.360buyimg.com': 'https://dns.alidns.com/dns-query'
    '+.baidu.com': 'https://dns.alidns.com/dns-query'
    '+.bdstatic.com': 'https://dns.alidns.com/dns-query'
    '+.bcebos.com': 'https://dns.alidns.com/dns-query'
    '+.163.com': 'https://dns.alidns.com/dns-query'
    '+.126.net': 'https://dns.alidns.com/dns-query'

  # 国内直连 App 不使用 Fake-IP，直接取得真实中国 CDN IP，提升兼容性与首开速度。
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.home.arpa'
    - '*.in-addr.arpa'
    - '*.ip6.arpa'
    - '*._dns-sd._udp.*.in-addr.arpa'
    - 'localhost'
    - 'localhost.weixin.qq.com'
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'
    - 'captive.apple.com'
    - '*.icloud.com'
    - '*.icloud-content.com'
    - '*.apple-cloudkit.com'
    - '*.cdn-apple.com'
    - '*.mzstatic.com'
    - '*.ccb.com'
    - '*.abchina.com.cn'
    - '*.psbc.com'
    - '*.taobao.com'
    - '*.tmall.com'
    - '*.alicdn.com'
    - '*.taobaocdn.com'
    - '*.tbcdn.cn'
    - '*.alipay.com'
    - '*.alipayobjects.com'
    - '*.goofish.com'
    - '*.xianyu.mobi'
    - '*.meituan.com'
    - '*.meituan.net'
    - '*.sankuai.com'
    - '*.dianping.com'
    - '*.dpfile.com'
    - '*.ele.me'
    - '*.amap.com'
    - '*.autonavi.com'
    - '*.bilibili.com'
    - '*.biliapi.com'
    - '*.biliapi.net'
    - '*.bilivideo.com'
    - '*.hdslb.com'
    - '*.xiaohongshu.com'
    - '*.xhscdn.com'
    - '*.qq.com'
    - '*.qcloud.com'
    - '*.weixin.qq.com'
    - '*.jd.com'
    - '*.360buyimg.com'
    - '*.baidu.com'
    - '*.bdstatic.com'
    - '*.bcebos.com'
    - '*.163.com'
    - '*.126.net'
    - '*.douyin.com'
    - '*.douyincdn.com'
    - '*.byteimg.com'
    - '*.bytedance.com'
    - '*.toutiao.com'
    - '*.amap.com'
    - '*.amapauto.com'
    - '*.autonavi.com'
    - '*.gaode.com'

# ============================================================
# 2) 自动测速 / 策略组（120 秒自动重测）
# ============================================================
proxy-groups:
  - name: 🌐 STASH-全部自动
    type: url-test
    include-all: true
    interval: 120
    tolerance: 50
    lazy: true

  - name: 🇺🇸 STASH-美国自动
    type: url-test
    include-all: true
    filter: '(?i)(🇺🇸|美国|美國|US|USA|United States|America|Los Angeles|San Jose|Seattle|New York|Chicago|Dallas|Boston|Phoenix|洛杉矶|洛杉磯|圣何塞|聖何塞|西雅图|西雅圖|纽约|紐約|芝加哥|达拉斯|達拉斯|波士顿|波士頓|凤凰城|鳳凰城)'
    interval: 120
    tolerance: 50
    lazy: true

  - name: 🚀 STASH-主代理
    type: select
    proxies:
      - 🌐 STASH-全部自动
      - 🇺🇸 STASH-美国自动
      - DIRECT

  - name: 🤖 STASH-AI
    type: select
    proxies:
      - 🇺🇸 STASH-美国自动
      - 🌐 STASH-全部自动
      - DIRECT

  - name: 📹 STASH-YouTube
    type: select
    proxies:
      - 🌐 STASH-全部自动
      - 🇺🇸 STASH-美国自动
      - DIRECT

  - name: 🎵 STASH-Spotify
    type: select
    proxies:
      - 🌐 STASH-全部自动
      - 🇺🇸 STASH-美国自动
      - DIRECT

  - name: 🎬 STASH-TikTok
    type: select
    proxies:
      - 🇺🇸 STASH-美国自动
      - 🌐 STASH-全部自动
      - DIRECT

  - name: 🔍 STASH-Google
    type: select
    proxies:
      - 🇺🇸 STASH-美国自动
      - 🌐 STASH-全部自动
      - DIRECT

  - name: 📱 STASH-Telegram
    type: select
    proxies:
      - 🇺🇸 STASH-美国自动
      - 🌐 STASH-全部自动
      - DIRECT

  - name: 💻 STASH-开发服务
    type: select
    proxies:
      - 🌐 STASH-全部自动
      - 🇺🇸 STASH-美国自动
      - DIRECT

  - name: Ⓜ️ STASH-Microsoft
    type: select
    proxies:
      - 🌐 STASH-全部自动
      - 🇺🇸 STASH-美国自动
      - DIRECT

  - name: 🍏 STASH-Apple
    type: select
    proxies:
      - DIRECT
      - 🌐 STASH-全部自动
      - 🇺🇸 STASH-美国自动

  - name: 🐟 STASH-兜底
    type: select
    proxies:
      - 🌐 STASH-全部自动
      - 🇺🇸 STASH-美国自动
      - DIRECT

# ============================================================
# 3) 远程规则集
# ============================================================
rule-providers:
  # 国内核心服务：放在 HTTPDNS 拦截前，优先 DIRECT。
  Stash-Alibaba:
    behavior: domain
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Alibaba/Alibaba_Domain.yaml

  Stash-XianYu:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/XianYu/XianYu.yaml

