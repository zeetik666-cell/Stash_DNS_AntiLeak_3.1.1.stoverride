name: Stash Hybrid DNS Trial (CN Fast + Foreign Proxy 180s)
desc: 实验版。沿用已验证流畅的严格分流与180秒测速，国内明确域名定向国内DNS；其他域名用经自动代理的Cloudflare和Google DoH。原诊断版保持不变。请单独启用并核查DNS泄漏及米家淘宝速度。
category: General

ipv6: false

dns: #!replace
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  follow-rule: true
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  # 未列入中国国内域名白名单的查询，使用加密 DNS。
  # follow-rule=true 且 DNS 目标 IP 在下方规则中固定走安全代理。
  nameserver:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query
  # 已知国内应用及图片/CDN 域名用国内解析器，保持原始主配置的就近调度。
  # 按 Stash 3.1.1 使用标量 DNS 地址，不使用数组值。
  nameserver-policy:
    '+.mi.com': '119.29.29.29'
    '+.xiaomi.com': '119.29.29.29'
    '+.xiaomi.net': '119.29.29.29'
    '+.miui.com': '119.29.29.29'
    '+.mi-img.com': '119.29.29.29'
    '+.mi-cdn.com': '119.29.29.29'
    '+.mi-static.com': '119.29.29.29'
    '+.miot-spec.org': '119.29.29.29'
    '+.mipush.com': '119.29.29.29'
    '+.miwifi.com': '119.29.29.29'
    '+.xiaomicp.com': '119.29.29.29'
    '+.mijia.tech': '119.29.29.29'
    '+.xiaomidns.com': '119.29.29.29'
    '+.micoce.com.cn': '119.29.29.29'
    '+.mi.com.cn': '119.29.29.29'
    '+.mi.cn': '119.29.29.29'
    '+.xiaomi.cn': '119.29.29.29'
    '+.mi-cache.com': '119.29.29.29'
    '+.mi-img1.com': '119.29.29.29'
    '+.mi-img2.com': '119.29.29.29'
    '+.mi-img3.com': '119.29.29.29'
    '+.mi-img4.com': '119.29.29.29'
    '+.mi-img5.com': '119.29.29.29'
    '+.xiaomidns.cn': '119.29.29.29'
    '+.xiaomidns.com.cn': '119.29.29.29'
    '+.xiaomicache.com': '119.29.29.29'
    '+.apple.com.cn': '223.5.5.5'
    '+.icloud.com.cn': '223.5.5.5'
