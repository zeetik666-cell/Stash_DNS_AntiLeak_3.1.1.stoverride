  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.home.arpa'
    - '*.in-addr.arpa'
    - '*.ip6.arpa'
    - '*._dns-sd._udp.*.in-addr.arpa'
    - 'localhost'
    - 'localhost.weixin.qq.com'
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'
    - 'captive.apple.com'
    - '*.icloud.com'
    - '*.icloud-content.com'
    - '*.apple-cloudkit.com'
    - '*.cdn-apple.com'
    - '*.mzstatic.com'

proxy-groups:
  - name: ⚡ 通用最低延迟
    type: url-test
    include-all: true
    filter: '^(CF (电信|联通|移动)优选( [0-9]+)?|VPS789优选|WeTest优选|微测优选|优选 \|)'
    url: http://www.gstatic.com/generate_204
    interval: 180
    tolerance: 50
    lazy: true

rule-providers:
  Minimal-AppleMusic:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/AppleMusic/AppleMusic.yaml

  Minimal-AppStore:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/AppStore/AppStore.yaml

  Minimal-iCloud:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/iCloud/iCloud.yaml

  Minimal-AppleID:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/AppleID/AppleID.yaml

rules: #!replace
  # 国外 DoH 传输固定经安全代理，不允许从国内 DIRECT 发送。
  - IP-CIDR,1.1.1.1/32,⚡ 通用最低延迟,no-resolve
  - IP-CIDR,8.8.8.8/32,⚡ 通用最低延迟,no-resolve
  # 国内 DNS 上游的查询直接出站，避免被最终海外兜底代理。
  - IP-CIDR,223.5.5.5/32,DIRECT,no-resolve
  - IP-CIDR,119.29.29.29/32,DIRECT,no-resolve

  - DOMAIN,localhost.weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - DOMAIN-SUFFIX,home.arpa,DIRECT
  - DOMAIN-SUFFIX,in-addr.arpa,DIRECT
  - DOMAIN-SUFFIX,ip6.arpa,DIRECT
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  # 常见局域网发现：mDNS、SSDP 与 IPv4 广播；仅对被隧道捕获的报文有效
  - IP-CIDR,224.0.0.251/32,DIRECT,no-resolve
  - IP-CIDR,239.255.255.250/32,DIRECT,no-resolve
  - IP-CIDR,255.255.255.255/32,DIRECT,no-resolve

  # 米家中国大陆云服务 / 设备控制 / 状态 / 素材 / 推送（与原本局域网 DIRECT 规则共用）
  - DOMAIN-SUFFIX,mi.com,DIRECT
  - DOMAIN-SUFFIX,xiaomi.com,DIRECT
  - DOMAIN-SUFFIX,xiaomi.net,DIRECT
  - DOMAIN-SUFFIX,miui.com,DIRECT
