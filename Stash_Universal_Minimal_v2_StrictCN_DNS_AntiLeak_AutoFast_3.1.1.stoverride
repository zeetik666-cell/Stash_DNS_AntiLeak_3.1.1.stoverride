name: Stash Universal Minimal v2 (Strict CN + DNS AntiLeak + Auto Fast)
desc: 严格国内白名单修复版。移除错误包含外国检测网站的 ChinaMaxNoIP 广泛规则集，保留轻量 Fake-IP/DoH 和通用最低延迟组；仅明确国内应用和 Apple 服务直连，未命中一律代理。兼容 Stash 3.1.1。
category: General

ipv6: false

dns: #!replace
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  follow-rule: true
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.home.arpa'
    - '*.in-addr.arpa'
    - '*.ip6.arpa'
    - '*._dns-sd._udp.*.in-addr.arpa'
    - 'localhost'
    - 'localhost.weixin.qq.com'
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'
    - 'captive.apple.com'
    - '*.icloud.com'
    - '*.icloud-content.com'
    - '*.apple-cloudkit.com'
    - '*.cdn-apple.com'
    - '*.mzstatic.com'

proxy-groups:
  - name: ⚡ 通用最低延迟
    type: url-test
    include-all: true
    filter: '^(CF (电信|联通|移动)优选( [0-9]+)?|VPS789优选|WeTest优选|微测优选|优选 \|)'
    url: http://www.gstatic.com/generate_204
    interval: 600
    tolerance: 50
    lazy: true

rule-providers:
  Minimal-AppleMusic:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/AppleMusic/AppleMusic.yaml

  Minimal-AppStore:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/AppStore/AppStore.yaml

  Minimal-iCloud:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/iCloud/iCloud.yaml

  Minimal-AppleID:
    behavior: classical
    interval: 86400
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/AppleID/AppleID.yaml

rules: #!replace
  - DOMAIN,localhost.weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - DOMAIN-SUFFIX,home.arpa,DIRECT
  - DOMAIN-SUFFIX,in-addr.arpa,DIRECT
  - DOMAIN-SUFFIX,ip6.arpa,DIRECT
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve

  - DOMAIN-SUFFIX,bilibili.tv,⚡ 通用最低延迟
  - DOMAIN-SUFFIX,biliintl.com,⚡ 通用最低延迟
  - DOMAIN-SUFFIX,biliintl.co,⚡ 通用最低延迟
  - DOMAIN,p-bstarstatic.akamaized.net,⚡ 通用最低延迟
  - DOMAIN,p.bstarstatic.com,⚡ 通用最低延迟
  - DOMAIN,upos-bstar-mirrorakam.akamaized.net,⚡ 通用最低延迟
  - DOMAIN,upos-bstar1-mirrorakam.akamaized.net,⚡ 通用最低延迟

  - DOMAIN-SUFFIX,apple.com.cn,DIRECT
  - DOMAIN-SUFFIX,icloud.com.cn,DIRECT
  - RULE-SET,Minimal-AppleMusic,DIRECT
  - RULE-SET,Minimal-AppStore,DIRECT
  - RULE-SET,Minimal-iCloud,DIRECT
  - RULE-SET,Minimal-AppleID,DIRECT

  # 国内明确白名单，不使用宽泛 ChinaMaxNoIP / China / GEOIP,CN
  - DOMAIN-SUFFIX,taobao.com,DIRECT
  - DOMAIN-SUFFIX,tmall.com,DIRECT
  - DOMAIN-SUFFIX,alicdn.com,DIRECT
  - DOMAIN-SUFFIX,taobaocdn.com,DIRECT
